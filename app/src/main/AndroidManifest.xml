<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network and Communication Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Android 11+ Package Visibility Declarations -->
    <queries>
        <!-- WhatsApp Package Visibility -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />

        <!-- PDF Reader Viewers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>

        <!-- Phone Dialer -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="QuickLoan"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen (App Launch Entry Point) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Lender Portal Activities -->
        <activity
            android:name=".LenderMainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MasterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".ApproveLoanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TransferMoneyActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TodaysDueActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TodaysPaymentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PaymentHistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CustomerProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Customer Portal Activities -->
        <activity
            android:name=".CustomerMainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ApplyLoanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CustomerApprovedLoansActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CustomerLedgerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PayDailyEmiActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- FileProvider for PDF Viewing and WhatsApp Sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
