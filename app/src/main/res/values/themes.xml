<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QuickLoan" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Global Slate Window Canvas -->
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:colorBackground">@color/surface_bg</item>

        <!-- Brand Theming -->
        <item name="colorPrimary">@color/header_bg</item>
        <item name="colorPrimaryDark">#070A10</item>
        <item name="colorAccent">@color/brand_accent</item>

        <!-- Status Bar & Navigation Bar Colors -->
        <item name="android:statusBarColor">@color/header_bg</item>
        <item name="android:navigationBarColor">#070A10</item>
    </style>
</resources>
