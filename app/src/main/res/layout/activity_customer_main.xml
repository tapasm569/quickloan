<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="[http://schemas.android.com/apk/res/android](http://schemas.android.com/apk/res/android)"
    xmlns:app="[http://schemas.android.com/apk/res-auto](http://schemas.android.com/apk/res-auto)"
    android:id="@+id/drawer_layout_customer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:background="@color/surface_bg" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout android:background="@color/brand_primary" android:gravity="center_vertical" android:layout_height="60dp" android:layout_width="match_parent" android:orientation="horizontal" android:paddingHorizontal="16dp">

            <!-- Left: Customer Name -->
            <LinearLayout android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">

                <TextView android:id="@+id/tvToolbarCustomerName" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Loading..." android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>

                <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Customer Dashboard" android:textColor="#94A3B8" android:textSize="11sp"/>
            </LinearLayout>

            <!-- Right: 3-line Hamburger Menu Button -->
            <ImageButton android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Menu" android:id="@+id/btnRightHamburger" android:layout_height="44dp" android:layout_width="44dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#FFFFFF"/>
        </LinearLayout>

        <!-- Dashboard Options -->
        <ScrollView android:layout_height="match_parent" android:layout_width="match_parent" android:padding="16dp">

            <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardApplyLoan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">
                        <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="📝" android:textSize="24sp"/>
                        <TextView android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_width="wrap_content" android:text="Apply Loan" android:textColor="@color/text_main" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardApprovedDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">
                        <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="📑" android:textSize="24sp"/>
                        <TextView android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_width="wrap_content" android:text="Approved Loan Details" android:textColor="@color/text_main" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDailyEmi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">
                        <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="💳" android:textSize="24sp"/>
                        <TextView android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_width="wrap_content" android:text="Pay Daily EMI" android:textColor="@color/brand_emerald" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCustHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">
                        <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="🕒" android:textSize="24sp"/>
                        <TextView android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_width="wrap_content" android:text="Payment History" android:textColor="@color/text_main" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCustLedger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">
                        <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="⚖️" android:textSize="24sp"/>
                        <TextView android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_width="wrap_content" android:text="Ledger Balance" android:textColor="@color/brand_amber" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Right-Hand Side Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_customer_right"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/card_bg"
        app:headerLayout="@layout/nav_header_customer"
        app:itemIconTint="@color/brand_primary"
        app:itemTextColor="@color/text_main"
        app:menu="@menu/customer_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
