<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/headerCustomerProfile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_primary"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvHeaderAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/edittext_bg"
        android:backgroundTint="#334155"
        android:gravity="center"
        android:text="👤"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/tvHeaderCustomerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Customer Name"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeaderCustomerPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+91 0000000000"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap to view full profile ➔"
        android:textColor="@color/brand_accent"
        android:textSize="11sp" />
</LinearLayout>
