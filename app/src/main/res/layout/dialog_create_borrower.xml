<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Borrower Login"
        android:textColor="@color/text_main"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etBorrowerPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/edittext_bg"
        android:hint="Borrower Mobile Number"
        android:inputType="phone"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_muted" />

    <EditText
        android:id="@+id/etBorrowerPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/edittext_bg"
        android:hint="Set Password"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateId"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/brand_primary"
            android:text="Create ID"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendWhatsApp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#25D366"
            android:text="Send WhatsApp"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
