<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:orientation="vertical">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#111827"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/btnBackCustomerLedger"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Ledger Balance"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCustomerLedgerDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:backgroundTint="#1E293B"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="19-09-2026"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Metrics Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout android:gravity="center" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="10dp">
                <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="APPROVED" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvCustApprovedLoan" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:text="₹0" android:textColor="#38BDF8" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout android:gravity="center" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="10dp">
                <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="PAID" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvCustPaidBalance" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:text="₹0" android:textColor="#10B981" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout android:gravity="center" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="10dp">
                <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="REMAINING" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvCustRemainingBalance" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:text="₹0" android:textColor="#F59E0B" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- PDF Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCustViewPdf"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:backgroundTint="#2563EB"
            android:text="📄 View PDF"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCustSendWa"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:backgroundTint="#10B981"
            android:text="💬 Send To Whatsapp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Table Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="10dp"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="center" android:text="SL" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="95dp" android:layout_height="wrap_content" android:gravity="center" android:text="DATE" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:paddingEnd="10dp" android:text="PAID" android:textColor="#10B981" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:gravity="end" android:paddingEnd="6dp" android:text="REMAINING" android:textColor="#F59E0B" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyCustomerLedger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="30dp"
        android:text="No payment records found"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomerLedger"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp" />

</LinearLayout>
