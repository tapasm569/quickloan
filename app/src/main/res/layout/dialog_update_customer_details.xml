<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Personal Details"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Keep your loan payout details updated"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="LOAN DISBURSEMENT (PAYOUT)"
            android:textColor="@color/brand_emerald"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUpdateUpi"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_bg"
            android:hint="UPI ID (e.g. name@okhdfcbank)"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="ADDRESS DETAILS"
            android:textColor="@color/brand_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUpdateVillage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_bg"
            android:hint="Village (Vill)"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_muted" />

        <EditText
            android:id="@+id/etUpdatePO"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_bg"
            android:hint="Post Office (P.O)"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_muted" />

        <EditText
            android:id="@+id/etUpdatePS"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_bg"
            android:hint="Police Station (P.S)"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_muted" />

        <EditText
            android:id="@+id/etUpdateDistrict"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_bg"
            android:hint="District"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_muted" />

        <EditText
            android:id="@+id/etUpdatePin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_bg"
            android:hint="Pin Code"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_muted" />
    </LinearLayout>
</ScrollView>
