<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="680dp"
    android:layout_height="48dp"
    android:background="#0F172A"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <!-- Sl No -->
    <TextView
        android:id="@+id/tvRowSlNo"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <!-- Borrower Name -->
    <TextView
        android:id="@+id/tvRowName"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:text="Customer Name"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Due Today -->
    <TextView
        android:id="@+id/tvRowTodaysDue"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="8dp"
        android:text="₹0"
        android:textColor="#F43F5E"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Today Collection -->
    <TextView
        android:id="@+id/tvRowTodaysCollection"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="8dp"
        android:text="₹0"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Total Paid -->
    <TextView
        android:id="@+id/tvRowTotalPaid"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="8dp"
        android:text="₹0"
        android:textColor="#10B981"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Remaining Balance -->
    <TextView
        android:id="@+id/tvRowRemainingBalance"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="8dp"
        android:text="₹0"
        android:textColor="#F59E0B"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Hidden compatibility tags -->
    <TextView
        android:id="@+id/tvRowDate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvRowTodaysPayment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
