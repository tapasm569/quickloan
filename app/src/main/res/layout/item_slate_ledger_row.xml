<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="#0F172A"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <!-- Sl No -->
    <TextView
        android:id="@+id/tvRowSlNo"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <!-- Date (DD-MM-YYYY) -->
    <TextView
        android:id="@+id/tvRowDate"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="19-09-2026"
        android:textColor="#64748B"
        android:textSize="9sp" />

    <!-- Borrower Name -->
    <TextView
        android:id="@+id/tvRowName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Customer Name"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Today's Due -->
    <TextView
        android:id="@+id/tvRowTodaysDue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:text="₹0"
        android:textColor="#F43F5E"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- All Collected Sum Amount (Paid Amount) -->
    <TextView
        android:id="@+id/tvRowTodaysPayment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:text="₹0"
        android:textColor="#10B981"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Remaining Balance -->
    <TextView
        android:id="@+id/tvRowRemainingBalance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:text="₹0"
        android:textColor="#F59E0B"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
