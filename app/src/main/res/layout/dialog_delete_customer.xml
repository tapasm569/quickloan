<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header Warning Icon & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/edittext_bg"
                android:backgroundTint="#2D1A24"
                android:gravity="center"
                android:text="⚠️"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security Verification"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDialogDeleteSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Authorize borrower deletion"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="To verify this action, tap below to dispatch a secret 6-digit security code directly to your WhatsApp (+91 9932655607)."
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <!-- Step 1 Button: Send Code to WhatsApp -->
        <Button
            android:id="@+id/btnDialogSendWaCode"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#10B981"
            android:text="📲 Send Secret Code to WhatsApp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCodeSentNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="✓ Secret code sent to WhatsApp! Check your chat."
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Step 2: Code Input Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ENTER 6-DIGIT SECRET CODE"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDialogSecretCode"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_bg"
            android:gravity="center"
            android:hint="• • • • • •"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDialogCancelDelete"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="#334155"
                android:text="Cancel"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDialogConfirmDelete"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="#EF4444"
                android:text="Verify &amp; Delete"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
