<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUBMIT YOUR PERSONAL DETAILS"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="One-time verification setup"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Full Name"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted" />

                <EditText
                    android:id="@+id/etDob"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Date of Birth (YYYY-MM-DD)"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:text="ADDRESS DETAILS"
                    android:textColor="@color/brand_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etVillage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Village"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted" />

                <EditText
                    android:id="@+id/etPO"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Post Office"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted" />

                <EditText
                    android:id="@+id/etPS"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Police Station"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted" />

                <EditText
                    android:id="@+id/etDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="District"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted" />

                <EditText
                    android:id="@+id/etPin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Pin Code"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted" />

                <EditText
                    android:id="@+id/etRefContact"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Reference Contact Number"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitProfile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/brand_primary"
                    android:text="SAVE DETAILS &amp; ENTER"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
